{
  "name": "free-spotify-downloader",
  "productName": "Free Spotify Downloader",
  "version": "0.2.1",
  "private": true,
  "description": "Your music, your collection. A desktop music workspace by Jedi Meister.",
  "author": {
    "name": "Jedi Meister"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reini101083/free-spotify-downloader.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build:engine": "python scripts/build_engine.py",
    "package": "npm run build:web && electron-builder --publish never",
    "package:dir": "npm run build:web && electron-builder --dir --publish never",
    "dev": "vite",
    "licenses": "python scripts/collect_licenses.py",
    "test:engine": "python -m unittest discover -s tests -p test_*.py",
    "build:site": "npm run build:web && node scripts/build-sites.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "deno": "2.9.6",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "lucide": "0.577.0",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "app.jedimeister.free-spotify-downloader",
    "copyright": "Copyright \u00a9 2026 Jedi Meister",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "shared/**",
      "web/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "engine-dist",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "LICENSE",
          "README.md",
          "ffmpeg.LICENSE",
          "ffmpeg.README"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "node_modules/deno",
        "to": "deno",
        "filter": [
          "deno",
          "deno.exe",
          "LICENSE"
        ]
      }
    ],
    "artifactName": "Free-Spotify-Downloader-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Free-Spotify-Downloader-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Jedi Meister <jedi-meister@users.noreply.github.com>",
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png",
    "portable": {
      "artifactName": "Free-Spotify-Downloader-${version}-windows-${arch}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
